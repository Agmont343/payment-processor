# Docker Compose environment (внутренние адреса сервисов docker-сети).
# Скопируйте в .env.docker и подставьте свои значения:
#   cp .env.docker.example .env.docker

API_KEY=change-me-strong-api-key

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=payments

DB_URL=postgresql+asyncpg://postgres:change-me@postgres:5432/payments
TEST_DB_URL=postgresql+asyncpg://postgres:change-me@postgres:5432/payments_test
DB_ECHO=false

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
TEST_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/test

WEBHOOK_ALLOW_PRIVATE=false
